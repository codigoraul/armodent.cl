---
import Icon from './Icon.astro';
import ServicioCard from './ServicioCard.astro';
import { getServicios } from '../lib/wp';
import { u } from '../lib/url';
const todos = await getServicios();
const visibles = todos.slice(0, 8);
---
<div class="especialidades">
  <ol class="lista">
    {visibles.map((s, i) => <li class="reveal"><ServicioCard s={s} n={i + 1} /></li>)}
  </ol>
  <div class="mas">
    <a href={u('/servicios/')} class="btn btn-outline">Ver todas las especialidades <Icon name="arrow" size={14} /></a>
  </div>
</div>
<style>
  .lista { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2vw, 28px); }
  .lista li { list-style: none; }
  .mas { display: flex; justify-content: center; margin-top: 40px; }
  @media (max-width: 1000px) { .lista { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .lista { grid-template-columns: 1fr; } }
</style>
