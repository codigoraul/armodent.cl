---
import Icon from './Icon.astro';
import { getServicios } from '../lib/wp';
import { servicioHref } from '../lib/images';
import { u } from '../lib/url';
const todos = await getServicios();
const tonos = ['nude', 'palido', 'arena'] as const;
---
<div class="especialidades">
  <ol class="lista">
    {todos.map((s, i) => (
      <li class={`item ${tonos[i % tonos.length]} reveal`}>
        <a href={servicioHref(s.slug)}>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <span class="tx"><strong>{s.title}</strong><span class="ex">{s.excerpt}</span></span>
          <span class="go" aria-hidden="true"><Icon name="arrow" size={14} /></span>
        </a>
      </li>
    ))}
  </ol>
  <a href={u('/servicios/')} class="more">Ver todas las especialidades <Icon name="arrow" size={13} /></a>
</div>
<style>
  .lista { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 24px; counter-reset: none; }
  .item a { display: flex; align-items: flex-start; gap: 20px; height: 100%; padding: 24px 26px; border-radius: 12px; color: var(--tinta); transition: transform .3s, box-shadow .3s; }
  .item a:hover { transform: translateY(-3px); box-shadow: 0 26px 44px -30px rgb(58 42 38 / .5); }
  .item.nude a { background: var(--rosa-nude); } .item.palido a { background: var(--rosa-palido); } .item.arena a { background: #ead6c3; }
  .n { font: italic 400 1.75rem/1 var(--f-titulo); color: #5a3a33; flex: none; min-width: 2.2ch; }
  .tx { display: grid; gap: 6px; flex: 1; }
  strong { font: 400 var(--fs-h3)/1.2 var(--f-titulo); }
  .ex { color: #4a322d; font-size: 15px; max-width: 52ch; }
  .go { flex: none; align-self: center; opacity: .65; transition: transform .2s, opacity .2s; }
  .item a:hover .go { opacity: 1; transform: translate(2px, -2px); }
  .more { margin-top: 36px; display: inline-flex; align-items: center; gap: 10px; font-weight: 500; font-size: 15px; border-bottom: 1px solid currentColor; padding-bottom: 3px; color: var(--cobre-texto); }
  .more:hover { color: var(--tinta); }
  @media (max-width: 860px) { .lista { grid-template-columns: 1fr; } }
</style>
