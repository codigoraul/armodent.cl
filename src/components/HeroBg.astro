---
import { Image } from 'astro:assets';
import fondo from '../assets/hero-interno.jpg';
---
<div class="herobg" aria-hidden="true">
  <Image src={fondo} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" />
</div>
<style>
  .herobg { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .herobg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 55%; transform: scale(1.02); }
  .herobg::after { content: ''; position: absolute; inset: 0;
    background: linear-gradient(100deg, rgb(17 24 39 / .82) 0%, rgb(17 24 39 / .70) 52%, rgb(17 24 39 / .55) 100%); }
  @media (max-width: 900px) { .herobg::after { background: linear-gradient(180deg, rgb(17 24 39 / .80), rgb(17 24 39 / .70)); } }
</style>
