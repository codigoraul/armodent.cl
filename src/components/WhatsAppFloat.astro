---
import { getAjustes } from '../lib/wp';
import { waLink } from '../lib/contact';
const a = await getAjustes();
const base = waLink(a);
const href = base ? `${base}?text=${encodeURIComponent('Hola, quisiera agendar una hora en ARMODENT.')}` : '';
---
{href && (
  <a class="wa-float" href={href} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
    <svg viewBox="0 0 32 32" width="34" height="34" aria-hidden="true" fill="currentColor"><path d="M16.04 3C9.4 3 4 8.4 4 15.04c0 2.12.55 4.19 1.6 6.02L4 28l7.1-1.86a12 12 0 0 0 4.94 1.06h.01C22.68 27.2 28 21.8 28 15.16 28 8.5 22.68 3 16.04 3Zm0 21.9h-.01a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-4.21 1.1 1.12-4.1-.24-.38a9.9 9.9 0 0 1-1.52-5.27c0-5.47 4.45-9.92 9.93-9.92 5.47 0 9.92 4.45 9.92 9.92 0 5.47-4.45 9.25-9.58 10.25Zm5.44-7.43c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z"/></svg>
  </a>
)}
<style>
  .wa-float { position: fixed; right: clamp(16px, 2.2vw, 28px); bottom: clamp(16px, 2.2vw, 28px); z-index: 90; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: #4b9a9c; color: #fff; border: 1px solid rgb(255 248 245 / .35); box-shadow: 0 0 0 5px rgb(75 154 156 / .22), 0 12px 28px -12px rgb(17 24 39 / .45); transition: background .3s, box-shadow .3s, transform .3s; }
  .wa-float:hover, .wa-float:focus-visible { background: #3e8789; transform: translateY(-2px); box-shadow: 0 0 0 7px rgb(75 154 156 / .3), 0 16px 32px -12px rgb(17 24 39 / .5); }
  .wa-float:focus-visible { outline: 2px solid #111827; outline-offset: 4px; }
  @media (max-width: 520px) { .wa-float { width: 48px; height: 48px; } }
  @media (prefers-reduced-motion: reduce) { .wa-float { transition: none; } }
</style>
