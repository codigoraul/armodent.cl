---
import Icon from './Icon.astro';
import Media from './Media.astro';
import { imagenDeServicio, servicioHref } from '../lib/images';
const { s, n } = Astro.props;
const im = s.image ? { src: s.image, pos: '50% 40%' } : imagenDeServicio(s.slug);
---
<a href={servicioHref(s.slug)} class="card" aria-label={s.title}>
  <span class="ph" style={`--cpos:${im.pos}`}><Media src={im.src} alt="" sizes="(max-width: 600px) 90vw, 300px" /></span>
  <span class="n" aria-hidden="true">{String(n).padStart(2, '0')}</span>
  <span class="info">
    <strong>{s.title}</strong>
    <span class="ex">{s.excerpt}</span>
    <span class="btn btn-primary">Saber más <Icon name="arrow" size={13} /></span>
  </span>
</a>
<style>
  .card { position: relative; display: flex; flex-direction: column; height: 100%; border-radius: 14px; overflow: hidden; color: var(--tinta); background: #fffaf8; box-shadow: 0 1px 0 rgb(17 24 39 / .08), 0 18px 40px -28px rgb(17 24 39 / .5); transition: transform .3s, box-shadow .3s; }
  .card:hover, .card:focus-visible { transform: translateY(-4px); box-shadow: 0 1px 0 rgb(17 24 39 / .1), 0 30px 54px -30px rgb(17 24 39 / .55); }
  .ph { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--nude-suave); }
  .ph :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--cpos, 50% 50%); filter: saturate(.92); transition: transform .6s ease; }
  .card:hover .ph :global(img) { transform: scale(1.06); }
  .n { position: absolute; top: 12px; left: 16px; font: italic 400 1.9rem/1 var(--f-titulo); color: #fff; text-shadow: 0 2px 14px rgb(17 24 39 / .6); }
  .info { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 20px 18px 22px; text-align: center; }
  strong { font: 400 clamp(1.4rem, 1.9vw, 1.75rem)/1.18 var(--f-titulo); color: #111827; text-wrap: balance; overflow-wrap: break-word; hyphens: auto; max-width: 100%; }
  .ex { font-size: 15px; line-height: 1.5; color: var(--tinta); }
  .info .btn { margin-top: auto; padding: 13px 26px; font-size: 16px; font-weight: 400; }
  .ex + .btn { margin-top: auto; }
  /* Botón con marco negro del logo; al pasar el mouse se rellena */
  .info .btn-primary { background: transparent; color: var(--negro); border: 1px solid #111827; text-shadow: none; font-weight: 400; transition: background .25s, color .25s; }
  .card:hover .info .btn-primary, .card:focus-visible .info .btn-primary { background: #fdbd99; border-color: #fdbd99; color: var(--negro); }
</style>
