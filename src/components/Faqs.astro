---
import Icon from './Icon.astro';
import { getFaqs } from '../lib/wp';
const { limit, eyebrow = 'Preguntas frecuentes', titulo = 'Antes de venir,<br />hablemos.', texto = 'Cada pregunta importa. Aquí tienes un primer acercamiento a tu visita.' } = Astro.props;
const todas = await getFaqs();
const faqs = limit ? todas.slice(0, limit) : todas;
---
<section class="section">
  <div class="wrap grid">
    <div class="reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="section-title" set:html={titulo} />
      <p class="lede">{texto}</p>
      <slot />
    </div>
    <div class="lista reveal">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary><span>{f.q}</span><Icon name="plus" size={18} /></summary>
          <div class="resp" set:html={f.a.startsWith('<') ? f.a : `<p>${f.a}</p>`} />
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 7vw, 110px); align-items: start; }
  .grid .eyebrow { margin-bottom: 18px; } .lede { margin-top: 22px; max-width: 30ch; }
  details { border-bottom: 1px solid var(--linea); } details:first-child { border-top: 1px solid var(--linea); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 24px 0; font-size: 1.1rem; }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { color: var(--terracota); flex: none; transition: transform .25s; }
  details[open] summary :global(svg) { transform: rotate(45deg); }
  .resp { padding: 0 48px 26px 0; color: var(--tinta-suave); max-width: 62ch; }
  .resp :global(p) { margin: 0; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
