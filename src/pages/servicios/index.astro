---
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Media from '../../components/Media.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getServicios } from '../../lib/wp';
import { imagenDeServicio, servicioHref } from '../../lib/images';
import { u } from '../../lib/url';
const todos = await getServicios();
---
<Page title="Especialidades y servicios · ARMODENT" description="Odontología general, implantología, cirugía bucomaxilofacial, endodoncia, ortodoncia, periodoncia, rehabilitación oral, odontopediatría, TTM y dolor orofacial, y estética facial en ARMODENT." current="servicios">
  <PageHero
    eyebrow="Servicios"
    title="Especialidades <em>y servicios.</em>"
    lead="Desde la prevención hasta la atención especializada: conoce las áreas que forman parte de ARMODENT."
    crumbs={[{ label: 'Inicio', href: u('/') }, { label: 'Servicios' }]}
  />

  <section class="section">
    <div class="wrap">
      <ol class="lista" id="lista-servicios">
        {todos.map((s, i) => { const im = s.image ? { src: s.image, pos: '50% 40%' } : imagenDeServicio(s.slug); return (
          <li class:list={['reveal', { extra: i >= 8 }]}>
            <a href={servicioHref(s.slug)} class="card" aria-label={s.title}>
              <span class="ph" style={`--cpos:${im.pos}`}><Media src={im.src} alt="" sizes="(max-width: 600px) 90vw, 260px" /></span>
              <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="info">
                <strong>{s.title}</strong>
                <span class="ex">{s.excerpt}</span>
                <span class="btn btn-primary">Saber más <Icon name="arrow" size={13} /></span>
              </span>
            </a>
          </li>
        ); })}
      </ol>
      {todos.length > 8 && (
        <div class="mas">
          <button type="button" class="btn btn-outline" id="ver-mas" aria-expanded="false" aria-controls="lista-servicios">Ver más especialidades <Icon name="plus" size={14} /></button>
        </div>
      )}
      <noscript><style is:inline set:html=".extra{display:list-item!important}.mas{display:none}"></style></noscript>
      <p class="nota">La indicación de cada tratamiento requiere una evaluación clínica individual.</p>
    </div>
  </section>
  <CtaBand titulo="¿No sabes por dónde empezar?<br />Te orientamos." texto="Cuéntanos qué te preocupa y te ayudamos a elegir el primer paso." />
</Page>

<script>
  const btn = document.getElementById('ver-mas');
  const lista = document.getElementById('lista-servicios');
  btn?.addEventListener('click', () => {
    lista?.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
    btn.parentElement?.remove();
    lista?.querySelectorAll('.extra .reveal, .extra').forEach((el) => el.classList.add('in'));
  });
</script>

<style>
  .lista { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2vw, 28px); }
  .lista li { list-style: none; }
  .lista:not(.open) .extra { display: none; }
  .mas { display: flex; justify-content: center; margin-top: 40px; }
  .card { position: relative; display: flex; flex-direction: column; height: 100%; border-radius: 14px; overflow: hidden; color: var(--tinta); background: #fffaf7; box-shadow: 0 1px 0 rgb(138 75 64 / .08), 0 18px 40px -28px rgb(58 42 38 / .5); transition: transform .3s, box-shadow .3s; }
  .card:hover, .card:focus-visible { transform: translateY(-4px); box-shadow: 0 1px 0 rgb(138 75 64 / .1), 0 30px 54px -30px rgb(58 42 38 / .55); }
  .ph { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--nude-suave); }
  .ph :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--cpos, 50% 50%); filter: saturate(.92); transition: transform .6s ease; }
  .card:hover .ph :global(img) { transform: scale(1.06); }
  .n { position: absolute; top: 12px; left: 16px; font: italic 400 1.9rem/1 var(--f-titulo); color: #fff; text-shadow: 0 2px 14px rgb(58 42 38 / .6); }
  .info { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 20px 18px 22px; text-align: center; }
  strong { font: 400 clamp(1.4rem, 1.9vw, 1.75rem)/1.18 var(--f-titulo); color: #1f1715; text-wrap: balance; overflow-wrap: break-word; hyphens: auto; max-width: 100%; }
  .ex { font-size: 15px; line-height: 1.5; color: var(--tinta); }
  .info .btn { margin-top: auto; padding: 12px 24px; font-size: 14px; }
  .ex + .btn { margin-top: auto; }
  .nota { margin-top: 32px; font-size: 14px; color: var(--tinta-suave); }
  @media (max-width: 1000px) { .lista { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .lista { grid-template-columns: 1fr; } }
</style>
