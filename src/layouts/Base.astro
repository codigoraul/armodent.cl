---
import '../styles/global.css';
import { u } from '../lib/url';
const { title, description } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const ld = { '@context': 'https://schema.org', '@type': ['Dentist', 'MedicalBusiness'], name: 'ARMODENT', description, url: Astro.site?.toString(), image: new URL('/og.jpg', Astro.site).toString(), slogan: 'Tu sonrisa. Tu esencia. En armonía.' };
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fedecc" />
    <link rel="canonical" href={url} />
    <link rel="icon" href={u('/favicon.ico') + '?v=2'} sizes="48x48" />
    <link rel="icon" href={u('/favicon.svg') + '?v=2'} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png') + '?v=2'} />
    <link rel="manifest" href={u('/site.webmanifest') + '?v=2'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a href="#contenido" class="sr-only">Saltar al contenido</a>
    <slot />
    <script>
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
